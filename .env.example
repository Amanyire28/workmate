APP_NAME=WorkMate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=workmate
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=129600

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: needed for email confirmation and password reset.
# Check the settings with: php artisan workmate:mail-test you@example.com
# For local development without a mail server, MAIL_MAILER=log writes emails to storage/logs/laravel.log
MAIL_MAILER=smtp
MAIL_HOST=your_smtp_host
MAIL_PORT=587
MAIL_USERNAME=your_smtp_user
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain
MAIL_FROM_NAME="${APP_NAME}"

# Push notifications (VAPID). Create the keys once with: php artisan workmate:push-keys
# Keep the private key secret. Changing the keys later turns notifications off on every device.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: a mailto: or https address push services can contact (defaults to APP_URL)
VAPID_SUBJECT=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# "What's New" release announcement (config/announcements.php): off until the release is approved
WHATS_NEW_ENABLED=false
WHATS_NEW_STARTS_AT=

# Community videos in Cloudflare R2 (config/videos.php). Server-side only: never VITE_*.
# Use an R2 API token limited to Object Read & Write on this one bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_VIDEO_BUCKET=workmate-community-videos
R2_ENDPOINT=

# Security (config/security.php). Nothing changes until APP_PUBLIC_URL is set. On the live server:
#   APP_PUBLIC_URL=https://wm.resnetsystems.com
# Email links are then built only from it, other Host headers are refused, CORS allows only it, and HSTS is sent.
APP_PUBLIC_URL=
# Other host names this site answers to, comma separated (e.g. a www. alias)
TRUSTED_HOSTS=
# Other websites allowed to call the API (the site itself needs none)
CORS_ALLOWED_ORIGINS=
# Strict-Transport-Security max-age in seconds (0 = off); sent only when APP_PUBLIC_URL is https
HSTS_SECONDS=15552000
# Content Security Policy: report-only (reports, blocks nothing), enforce, or off
CSP_MODE=report-only
